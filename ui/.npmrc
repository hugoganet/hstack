# @gomoso-ai/design-system is published privately to GitHub Packages.
# Auth comes from the NODE_AUTH_TOKEN env var (needs the read:packages scope):
#   NODE_AUTH_TOKEN=$(gh auth token) npm install
# A token in your ~/.npmrc works too.
@gomoso-ai:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}
legacy-peer-deps=true
