# Copy to .env.local and adjust — Next.js loads it automatically, so a plain
# `npm run dev` works with no env vars on the command line.

# Consuming repos to read telemetry from (comma- or colon-separated).
HSTACK_REPOS=/path/to/repo-a,/path/to/repo-b

# Optional overrides:
# HSTACK_REPO=/path/to/single-repo
# HSTACK_REPORTS_DIR=/explicit/dir/of/report-jsons
# HSTACK_BRAIN_DIR=/path/to/hstack/brain/recommendations   (default: ../brain/recommendations)
